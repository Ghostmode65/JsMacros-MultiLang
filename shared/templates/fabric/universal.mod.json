{
  "schemaVersion": 1,
  "id": "jsmacros_multilang",
  "version": "@version@",
  "name": "JsMacros Multi-Language",
  "description": "Shared Lua, Python, and Ruby engines for JsMacros Legacy, Community, and Reloaded",
  "environment": "client",
  "jars": [
@jars@
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": [">=1.19 <1.22", "26.2"],
    "java": ">=17",
    "jsmacros_multilang_adapter": "*"@runtimeDependencies@
  },
  "custom": {
    "jsmacros_multilang:target": "universal",
    "jsmacros_multilang:adapters": {
@adapters@
    },
    "jsmacros_multilang:runtimes": {
      "jython": "@jythonVersion@",
      "luava": "@luavaVersion@",
      "jruby": "@jrubyVersion@",
      "jrubyLegacy": "@jrubyLegacyVersion@",
      "graalpy": "@graalVersion@"
    }
  }
}
